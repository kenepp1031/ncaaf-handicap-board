# Python
__pycache__/
*.pyc
.pytest_cache/

# Atomic-write temporaries
*.tmp

# The pipeline's SQLite database. Regenerable by re-running the ingest
# modules (python main.py --ingest-seasons ...); not tracked because it
# grows every run and isn't meaningfully diffable. If you want it backed up,
# copy ncaaf_handicap.db somewhere outside the repo rather than committing it.
ncaaf_handicap.db

# Database backups taken before destructive migrations.
ncaaf_handicap.db.bak-*
